# ── Upstash Redis ────────────────────────────────────────────────────────────
# Setzt die Vercel-Integration automatisch. Dieselbe Datenbank wie der Trainer:
# Nutzerliste und Anmeldung sind geteilt.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signiert das Session-Cookie. Eigener Wert je Projekt.
SESSION_SECRET=

# ── Web Push (Angebote) ──────────────────────────────────────────────────────
# Erzeugen mit: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# Schuetzt /api/angebote/cron. Vercel schickt ihn als "Authorization: Bearer ..."
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Postleitzahl fuer Nutzer, die noch keine gesetzt haben.
DEFAULT_PLZ=48155

# Spritpreise von tankerkoenig.de. Ein eigener Schluessel ist kostenlos.
# Ohne ihn laeuft die App mit dem Demo-Schluessel aus der Dokumentation:
# Namen, Marken, Entfernungen und Oeffnungszeiten stimmen, die Preise sind
# fuer alle Stationen derselbe Platzhalter - die Oberflaeche sagt das oben.
TANKERKOENIG_APIKEY=
